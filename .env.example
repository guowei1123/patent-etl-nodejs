# PostgreSQL 配置
CNIPA_PG_HOST=your-rds-host.pg.rds.aliyuncs.com
CNIPA_PG_PORT=5432
CNIPA_PG_DB=your_db_name
CNIPA_PG_USER=your_pg_user
CNIPA_PG_PASSWORD=replace-with-real-password

# OSS 配置
CNIPA_OSS_ACCESS_KEY_ID=replace-with-your-access-key-id
CNIPA_OSS_ACCESS_KEY_SECRET=replace-with-your-access-key-secret
CNIPA_OSS_BUCKET_NAME=your-oss-bucket
CNIPA_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
CNIPA_OSS_REGION=cn-hangzhou

# FTP 配置
CNIPA_FTP_HOST=ftp.cnipa.gov.cn
CNIPA_FTP_PORT=21
CNIPA_FTP_USER=anonymous
CNIPA_FTP_PASSWORD=
CNIPA_FTP_DATA_PATHS=/CN/CN-PA-TXTS-10-B_中国发明专利授权公告标准化全文文本数据/data,/CN/CN-PA-TXTS-20-U_中国实用新型专利授权公告标准化全文文本数据/data
FTP_TIMEOUT=120000
FTP_CONCURRENCY=3
FTP_RETRY_ATTEMPTS=3
FTP_RETRY_DELAY_MS=3000

# 认证配置
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-strong-password
SESSION_SECRET_KEY=replace-with-a-long-random-string
