# 本地数据存储配置
CNIPA_PG_HOST=127.0.0.1
CNIPA_PG_PORT=5432
CNIPA_PG_DB=patent_etl
CNIPA_PG_USER=postgres
CNIPA_PG_PASSWORD=replace-with-real-password

# 分类字典数据：本地 Redis
CLASSIFICATION_STORE=redis
REDIS_URL=redis://127.0.0.1:6379/0

# 图片对象存储：MinIO
OBJECT_STORAGE_TYPE=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-your-minio-access-key
MINIO_SECRET_KEY=replace-with-your-minio-secret-key
MINIO_BUCKET_NAME=patent-images
MINIO_REGION=us-east-1


# FTP 配置
CNIPA_FTP_HOST=ftp3.ipdps.cnipa.gov.cn
CNIPA_FTP_PORT=21
CNIPA_FTP_USER=replace-with-your-ftp-user
CNIPA_FTP_PASSWORD=replace-with-your-ftp-password
CNIPA_FTP_DATA_PATHS=/CN/CN-PA-TXTS-10-B_中国发明专利授权公告标准化全文文本数据/data,/CN/CN-PA-TXTS-20-U_中国实用新型专利授权公告标准化全文文本数据/data
FTP_TIMEOUT=120000
FTP_CONCURRENCY=2
FTP_RETRY_ATTEMPTS=3
FTP_RETRY_DELAY_MS=3000

# 认证配置
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-a-strong-password
SESSION_SECRET_KEY=replace-with-a-long-random-string

# OpenAI / 兼容 OpenAI 的大模型配置
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_CHAT_MODEL=deepseek-chat
# DeepSeek 暂未提供 embedding API，禁用语义搜索（前端会隐藏语义开关）
# OPENAI_EMBEDDING_MODEL=deepseek-embedding
# OPENAI_EMBEDDING_DIMENSIONS=1024
# OPENAI_EMBEDDING_BATCH_SIZE=10
# OPENAI_EMBEDDING_CONCURRENCY=3

